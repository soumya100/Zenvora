# ==============================================================================
# Zenvora Configuration - Environment Variables
# ==============================================================================
# Copy this file to .env and adjust the values according to your environment:
#   cp .env.example .env
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Backend Service Configuration
PORT=3000
HOST=0.0.0.0

# SearXNG Upstream Metasearch Engine
# In Docker Compose, this resolves to the internal container 'http://searxng:8080'
# In local development outside Docker, you can point to a local instance or leave fallback
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=change_this_to_a_random_32_character_hex_secret_in_production

# Domain Configuration
# Used by Caddy reverse proxy for automated HTTPS (Let's Encrypt / ZeroSSL)
# Set to 'localhost' for local testing, or your registered domain 'search.yourdomain.com'
DOMAIN=localhost

# Security & CORS
# Comma-separated list of allowed frontend origins
# E.g. 'https://search.yourdomain.com' or 'http://localhost:5173,http://localhost:3000'
CORS_ORIGIN=https://zenvora-beta.vercel.app,http://localhost:3000,http://localhost:5173

# Rate Limiting (Abuse Prevention)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
RATE_LIMIT_AI_MAX=15
RATE_LIMIT_IMAGE_PROXY_MAX=60
RATE_LIMIT_HEALTH_MAX=120

# Development & Mock Mode
# If true, backend provides rich simulated privacy search results if SearXNG is unreachable
MOCK_SEARCH=false

# AI Overview & Intelligence Integration (Optional)
# Server-side intelligence layer for Google-style AI Overview, intent classification, and chat.
# Supports NVIDIA Nemotron, OpenAI-compatible APIs, or any custom LLM endpoint.
AI_ENABLED=true
AI_PROVIDER=nvidia
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_TIMEOUT_MS=15000
AI_MAX_TOKENS=650

# Backwards compatible aliases for NVIDIA Nemotron:
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=15000
NVIDIA_MAX_TOKENS=500
